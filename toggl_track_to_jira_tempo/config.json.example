{
    "toggl": {
        "api_key": "YOUR_TOGGL_API_KEY"
    },
    "tempo": {
        "api_key": "YOUR_TEMPO_AUTH_TOKEN",
        "user_id": "JIRA_TEMPO_USER_ID"
    },
    "jira": {
        "subdomain": "YOUR_JIRA_SUBDOMAIN",
        "user_email": "YOUR_JIRA_USER_EMAIL",
        "api_token": "YOUR_JIRA_API_TOKEN"
    },
    "ticket_patterns": [
        "(?<![A-Za-z0-9])[A-Z]{2,5}-\\d{1,6}(?![A-Za-z0-9])"
    ]
}
